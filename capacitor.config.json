{
    "appId": "run.zone3.app",
    "appName": "Zone3",
    "webDir": "mobile/www",
    "server": {
        "url": "https://zone3.run",
        "appStartPath": "dashboard",
        "allowNavigation": [
            "zone3.run"
        ],
        "cleartext": false
    },
    "ios": {
        "contentInset": "never",
        "backgroundColor": "#000000"
    },
    "plugins": {
        "PushNotifications": {
            "presentationOptions": [
                "badge",
                "sound",
                "alert"
            ]
        }
    }
}
