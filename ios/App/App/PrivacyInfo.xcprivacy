<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Datenschutz-Manifest der App (App Store, seit 05/2024 Pflicht).
  Muss zu den Angaben in App Store Connect ("App-Datenschutz") passen.
  UserDefaults: WatchWorkoutsPlugin merkt sich, welche Einheit welches
  Training auf der Uhr ist (CA92.1 = nur in der App selbst gelesen).
  PreciseLocation = GPS-Strecken der Aktivitäten (von Uhr/Health, nicht vom iPhone-Standort).
-->
